{
  "name": "shop-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "minio:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/minio.ps1 install",
    "minio:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/minio.ps1 start",
    "minio:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/minio.ps1 stop",
    "minio:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/minio.ps1 status",
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "test:api": "vitest run --config vitest.api.config.js",
    "test:session": "vitest run --config vitest.session.config.js",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "format": "prettier --write src tests"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "antd": "^6.6.4",
    "i18next": "^26.4.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.15",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "minio": "^8.0.7",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.2"
  }
}
